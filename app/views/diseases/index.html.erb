<div class="row">
  <div class="col-12">
    <div class="card shadow">
      <div class="card-body bg-light rounded shadow">
        <div class="row">
          <div class="col mb-3">
            <span class="float-start">
              <%= image_tag("diseases_logo.svg", class: "img-fluid") %>
            </span>
            <span class="float-end">
              <%= link_to new_disease_path, "data-controller": "turbo", class: "btn btn-outline-primary" do %>
                <i class="fa-solid fa-plus"></i>
                &nbsp;
                <i class="fa-solid fa-thermometer"></i>
                &nbsp;
                Aggiungi Malattia
              <% end %>
            </span>
          </div>
        </div>
        <%= month_calendar(events: @diseases) do |date, diseases| %>
          <% if date.wday == 0 || date.wday == 6 %>
          <% else %>
            <div class='card border-primary rounded'>
              <div class='card-header bg-primary text-white text-center'>
                <i class='fas fa-calendar-day'></i>
                &nbsp;
                <%= l(date, format: "%a %d") %>
                &emsp;
                <span class='text-secondary'>
                  <%= l(date, format: "%b") %>
                </span>
              </div>
              <div class='card-body card-body-calendar'>
                <% diseases.each do |disease| %>
                  <span class="badge">
                    <%= link_to disease_path(disease), "data-controller": "turbo", "data-bs-toggle": "tooltip", "title": "Visualizza Dettaglio", class: "text-info" do %>
                      <i class='fas fa-user'></i>
                      &nbsp;
                      <%= "#{disease.user.last_name} #{disease.user.first_name.split.map { |i| i[0, 1].upcase }.join}" %>
                    <% end %>
                    <span class="text-dark">
                      <% if processed_disease(disease) %>
                      <% else %>
                        &emsp;
                        |
                        &emsp;
                        <%= link_to edit_disease_path(disease), "data-controller": "turbo", "data-bs-toggle": "tooltip", "title": "Modifica il Record Corrente", class: "text-warning" do %>
                          <i class="fa-solid fa-pen-to-square"></i>
                        <% end %>
                        &nbsp;
                        &nbsp;
                        <%= link_to disease_path(disease), "data-turbo-method": :delete, "data-turbo-confirm": "Sicuri di voler eliminare il record corrente?", "data-bs-toggle": "tooltip", "title": "Elimina il Record Corrente", class: "text-danger" do %>
                          <i class="fa-solid fa-trash"></i>
                        <% end %>
                      <% end %>
                    </span>
                  </span>
                  <br/>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
