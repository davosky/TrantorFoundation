<div class="container-fluid">
  <div class="row">
    <div class="col-4">
      <div class="card shadow">
        <div class="card-body bg-white rounded shadow">
          <p class="text-center">
            <%= image_tag("holidays_logo.svg", class: "img-fluid mb-3") %>
          </p>
          <%= search_form_for @q, id: 'search-form', url: search_holidays_path do |form| %>
            <div class="input-group mb-2">
              <div class="input-group-text input-group-text-fixed bg-primary text-white">
                <i class="fa-solid fa-calendar-day"></i>
                &nbsp;<span>Data Inizio</span>
              </div>
              <%= form.date_field :start_time_gteq, class: "form-control" %>
            </div>
            <div class="input-group mb-2">
              <div class="input-group-text input-group-text-fixed bg-primary text-white">
                <i class="fa-solid fa-calendar-day"></i>
                &nbsp;<span>Data Fine</span>
              </div>
              <%= form.date_field :start_time_lteq, class: "form-control" %>
            </div>
            <div class="input-group mb-2">
              <div class="input-group-text input-group-text-fixed bg-primary text-white">
                <i class="fa-solid fa-user-circle"></i>
                &nbsp;<span>Utente</span>
              </div>
              <% if god? %>
                <%= form.collection_select(:user_id_eq, User.order('last_name ASC'), :id, :user_name_full, {:include_blank => true}, {:class => 'form-control'}) %>
              <% elsif manager? %>
                <%= form.collection_select :user_id_eq, User.order('last_name ASC').where(province: current_user.province, region: current_user.region), :id, :user_name_full, {:include_blank => true}, {:class => 'form-control'} %>
              <% else %>
              <% end %>
            </div>
            <div class="d-grid">
              <%= button_tag(type: "submit", class: "btn btn-outline-primary") do %>
                <i class="fa-solid fa-magnifying-glass"></i>
                &emsp;
                <strong>
                  Cerca
                </strong>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-8">
      <div class="card shadow">
        <div class="card-body bg-white rounded shadow">
          <table class="table table-hover text-primary">
            <thead>
              <th>
                <i class="fa-solid fa-user-circle"></i>
                &nbsp;
                Utente
              </th>
              <th>
                <i class="fa-solid fa-calendar-day"></i>
                &nbsp;
                Data Inizio
              </th>
              <th>
                <i class="fa-solid fa-calendar-day"></i>
                &nbsp;
                Data Fine
              </th>
              <th>
                <i class="fa-solid fa-calendar-days"></i>
                &nbsp;
                Durata
              </th>
            </thead>
            <tbody>
              <% @total = 0 %>
              <% @holidays.each do |holiday| %>
                <tr>
                  <td>
                    <%= link_to holiday_path(holiday), "data-controller": "turbo", "data-bs-toggle": "tooltip", "title": "Visualizza Dettaglio" do %>
                      <%= "#{holiday.user.first_name} #{holiday.user.last_name}" %>
                    <% end %>
                  </td>
                  <td>
                    <%= l(holiday.start_time, format: "%A %d %B %Y") %>
                  </td>
                  <td>
                    <%= l(holiday.end_time, format: "%A %d %B %Y") %>
                  </td>
                  <td>
                    <strong class='text-primary'>
                      <%= holiday_duration(holiday).round %>
                      &emsp;
                      <% unless holiday_duration(holiday) > 1 %>
                        giorno
                      <% else %>
                        giorni
                      <% end %>
                    </strong>
                  </td>
                </tr>
                <% @total = @total + holiday_duration(holiday).round %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
