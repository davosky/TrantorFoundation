<%= form_with(model: refund_closure) do |form| %>
  <% if refund_closure.errors.any? %>
    <div class="row mb-2">
      <div class="card border-danger bg-white">
        <div class="card-body">
          <div class="row">
            <div class="col-6 text-center">
              <%= image_tag("error.svg", class: "img-fluid") %>
            </div>
            <div class="col-6">
              <h4 class="text-danger">Non posso salvare il record per i seguenti motivi:</h4>
              <ul>
                <% refund_closure.errors.each do |error| %>
                  <li class="text-danger"><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <% if current_user.god == true || current_user.admin == true || current_user.manager == true %>
    <div class="row">
      <div class="col">
        <div class="card border-primary mb-3">
          <div class="card-body border-primary">
            <span class="float-end">
              <strong>
                <%= form.check_box :payed, class: "form-check-input text-primary" %>
                &nbsp;
                <%= form.label :payed, class: "form-check-label text-primary" %>
                <i class="fa-solid fa-receipt text-primary"></i>
                <i class="fa-solid fa-cash-register text-primary"></i>
                &nbsp;
              </strong>
            </span>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <div class="row">
    <div class="col-6">
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-regular fa-calendar-days"></i>
          &nbsp;&nbsp;
          <%= form.label :year_reference %>
        </span>
        <%= form.text_field :year_reference, class: "form-control" %>
      </div>
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-calendar-days"></i>
          &nbsp;&nbsp;
          <%= form.label :month_reference %>
        </span>
        <%= form.text_field :month_reference, class: "form-control" %>
      </div>
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-calendar-week"></i>
          &nbsp;&nbsp;
          <%= form.label :period_reference %>
        </span>
        <%= form.text_field :period_reference, class: "form-control" %>
      </div>
    </div>
    <div class="col-6">
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-solid fa-wallet"></i>
          &nbsp;&nbsp;
          <%= form.label :print_refund %>
        </span>
        <%= form.file_field :print_refund, class: "form-control" %>
      </div>
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-regular fa-file-lines"></i>
          &nbsp;&nbsp;
          <%= form.label :summary_refund %>
        </span>
        <%= form.file_field :summary_refund, class: "form-control" %>
      </div>
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-solid fa-road"></i>
          &nbsp;&nbsp;
          <%= form.label :highway_movement_refund %>
        </span>
        <%= form.file_field :highway_movement_refund, class: "form-control" %>
      </div>
    </div>
  </div>
  <hr/>
  <div class="row">
    <div class="col-6">
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-solid fa-receipt"></i>
          &nbsp;&nbsp;
          <%= form.label :receipt_one_refund %>
        </span>
        <%= form.file_field :receipt_one_refund, class: "form-control" %>
      </div>
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-solid fa-receipt"></i>
          &nbsp;&nbsp;
          <%= form.label :receipt_two_refund %>
        </span>
        <%= form.file_field :receipt_two_refund, class: "form-control" %>
      </div>
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-solid fa-receipt"></i>
          &nbsp;&nbsp;
          <%= form.label :receipt_three_refund %>
        </span>
        <%= form.file_field :receipt_three_refund, class: "form-control" %>
      </div>
    </div>
    <div class="col-6">
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-solid fa-receipt"></i>
          &nbsp;&nbsp;
          <%= form.label :receipt_four_refund %>
        </span>
        <%= form.file_field :receipt_four_refund, class: "form-control" %>
      </div>
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-solid fa-receipt"></i>
          &nbsp;&nbsp;
          <%= form.label :receipt_five_refund %>
        </span>
        <%= form.file_field :receipt_five_refund, class: "form-control" %>
      </div>
      <div class="input-group mb-1">
        <span class="input-group-text input-group-text-fixed bg-primary text-white">
          <i class="fa-solid fa-paperclip"></i>
          <i class="fa-solid fa-receipt"></i>
          &nbsp;&nbsp;
          <%= form.label :receipt_six_refund %>
        </span>
        <%= form.file_field :receipt_six_refund, class: "form-control" %>
      </div>
    </div>
  </div>
  <br/>
  <div class="row">
    <div class="col-6 offset-3">
      <div class="d-grid">
        <%= form.submit class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>
<% end %>
