<div class="container">
  <div class="row">
    <div class="col-4">
      <div class="card shadow">
        <div class="card-body bg-white rounded shadow">
          <p class="text-center">
            <%= image_tag("transports_logo.svg", class: "img-fluid mb-3") %>
          </p>
          <div class="d-grid">
            <%= link_to new_transport_path, "data-controller": "turbo", class: "btn btn-outline-primary" do %>
              <i class="fa-solid fa-plus"></i>
              &nbsp;
              <i class="fa-solid fa-train"></i>
              &nbsp;
              Nuovo Trasporto
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-8">
      <div class="card shadow">
        <div class="card-body bg-white rounded shadow">
          <table class="table table-hover">
            <thead>
              <th><i class="fa-solid fa-train"></i></th>
              <th><i class="fa-solid fa-arrow-up-9-1"></i></th>
              <th colspan=2></th>
            </thead>
            <tbody>
              <% @transports.each do |transport| %>
                <tr>
                  <td>
                    <%= link_to transport_path(transport), "data-controller": "turbo" do %>
                      <%= transport.name %>
                    <% end %>
                  </td>
                  <td><%= transport.position %></td>
                  <td>
                    <%= link_to edit_transport_path(transport), "data-controller": "turbo", 
            "data-bs-toggle": "tooltip", 
            "title": "Modifica il Record Corrente", class: "text-warning" do %>
                      <i class="fa-solid fa-pen-to-square"></i>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to transport_path(transport),
            "data-turbo-method": :delete,
            "data-turbo-confirm": "Sicuri di voler ELIMINARE il record corrente", 
            "data-bs-toggle": "tooltip", 
            "title": "Elimina il Record Corrente", class: "text-danger" do%>
                      <i class="fa-solid fa-trash"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
